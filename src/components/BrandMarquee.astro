---
import { collaborations } from "../data/collaborations";
// Duplicate for seamless infinite scroll
const allBrands = [...collaborations, ...collaborations];
---

<section class="py-12 md:py-16 bg-cream/20 overflow-hidden relative">
  <!-- Fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-ivory to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-ivory to-transparent z-10 pointer-events-none"></div>

  <div class="text-center mb-8 reveal">
    <span class="text-taupe text-xs tracking-[0.3em] uppercase font-medium">Brands I've Worked With</span>
  </div>

  <div class="flex w-max flex-nowrap animate-marquee items-center">
    {allBrands.map((brand) => (
      <div class="inline-flex items-center mx-8 md:mx-12 flex-shrink-0">
        <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl overflow-hidden opacity-50 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0 cursor-default">
          <img
            src={brand.logo}
            alt={`${brand.name} logo`}
            class="w-full h-full object-cover"
            loading="lazy"
            width="56"
            height="56"
          />
        </div>
        <span class="ml-3 text-lg md:text-xl font-heading font-semibold text-mocha/30 hover:text-mocha transition-colors duration-300 cursor-default whitespace-nowrap select-none">
          {brand.name}
        </span>
      </div>
    ))}
  </div>
</section>
