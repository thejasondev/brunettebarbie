---
import { collaborations } from "../data/collaborations";
const brandNames = collaborations.map((c) => c.name);
// Duplicate for seamless infinite scroll
const allBrands = [...brandNames, ...brandNames];
---

<section class="py-12 md:py-16 bg-cream/30 overflow-hidden relative">
  <!-- Fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-ivory to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-ivory to-transparent z-10 pointer-events-none"></div>

  <div class="text-center mb-8 reveal">
    <span class="text-taupe text-xs tracking-[0.3em] uppercase font-medium">Brands I've Worked With</span>
  </div>

  <div class="flex animate-marquee whitespace-nowrap">
    {allBrands.map((name) => (
      <div class="inline-flex items-center mx-8 md:mx-12">
        <span class="text-2xl md:text-3xl font-heading font-semibold text-mocha/40 hover:text-mocha transition-colors duration-300 cursor-default whitespace-nowrap select-none">
          {name}
        </span>
      </div>
    ))}
  </div>
</section>
