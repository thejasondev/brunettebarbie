---
import { testimonials } from "../data/collaborations";
---

<section id="testimonials" class="py-20 md:py-28 bg-ivory relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute top-1/2 left-0 w-72 h-72 bg-cream/30 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-sand/10 rounded-full blur-3xl translate-x-1/3 translate-y-1/3 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 reveal">
      <span class="text-taupe text-sm tracking-[0.3em] uppercase font-medium block mb-3">What Brands Say</span>
      <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-dark font-bold mb-2">
        Brand <span class="text-mocha italic">Testimonials</span>
      </h2>
      <div class="w-16 h-0.5 bg-mocha mx-auto mt-6 mb-6"></div>
      <p class="max-w-2xl mx-auto text-taupe text-lg">
        Real feedback from the brands I've partnered with — relationships built on trust, creativity, and results.
      </p>
    </div>

    <!-- ============================================ -->
    <!-- MOBILE: Horizontal Snap Carousel (< 768px) -->
    <!-- ============================================ -->
    <div class="md:hidden -mx-6 px-6">
      <div class="testimonial-carousel flex gap-4 overflow-x-auto pb-4 -mb-4 snap-x snap-mandatory">
        {testimonials.slice(0, 3).map((testimonial, index) => (
          <article
            class="reveal group relative bg-white rounded-2xl p-6 shadow-card hover:shadow-card-hover transition-all duration-500 border border-transparent shrink-0 w-[85%] max-w-xs snap-center"
            style={`animation-delay: ${index * 0.1}s;`}
          >
            <!-- Quote icon -->
            <div class="absolute top-5 right-5 text-cream/60">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zm-14.017 0v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H0z"/>
              </svg>
            </div>

            <!-- Brand info -->
            <div class="flex items-center gap-3 mb-5">
              <div class="w-12 h-12 rounded-xl overflow-hidden shadow-sm flex-shrink-0">
                <img
                  src={testimonial.logo}
                  alt={`${testimonial.brand} logo`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width="48"
                  height="48"
                />
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold text-dark leading-tight">{testimonial.brand}</h3>
                <span class="text-xs text-taupe">{testimonial.role}</span>
              </div>
            </div>

            <!-- Quote -->
            <blockquote class="text-sm text-espresso/80 leading-relaxed mb-5 font-light italic">
              "{testimonial.quote}"
            </blockquote>

            <!-- Author -->
            <div class="flex items-center gap-2 pt-3 border-t border-cream/60">
              <div class="w-1.5 h-1.5 rounded-full bg-mocha/50"></div>
              <span class="text-sm text-taupe font-medium">{testimonial.author}</span>
            </div>
          </article>
        ))}
      </div>
      <!-- Scroll hint -->
      <div class="flex items-center justify-center gap-1.5 mt-3 text-taupe/70">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9L12 12.75 15.75 9M8.25 15L12 18.75 15.75 15"/>
        </svg>
        <span class="text-xs tracking-wide">Swipe to see more</span>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- TABLET (md) & DESKTOP (lg) GRID             -->
    <!-- Tablet: 4 (2x2) | Desktop: 6 (3x2)         -->
    <!-- ============================================ -->
    <div class="hidden md:grid grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {testimonials.map((testimonial, index) => (
        <div
          class={`reveal group relative bg-white rounded-2xl p-8 shadow-card hover:shadow-card-hover transition-all duration-500 hover:-translate-y-1 border border-transparent hover:border-sand/30 ${index >= 4 ? "hidden lg:block" : ""}`}
          style={`animation-delay: ${index * 0.1}s;`}
        >
          <!-- Quote icon -->
          <div class="absolute top-6 right-6 text-cream/60">
            <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zm-14.017 0v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H0z"/>
            </svg>
          </div>

          <!-- Brand info -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-xl overflow-hidden shadow-sm flex-shrink-0">
              <img
                src={testimonial.logo}
                alt={`${testimonial.brand} logo`}
                class="w-full h-full object-cover"
                loading="lazy"
                width="48"
                height="48"
              />
            </div>
            <div>
              <h3 class="font-heading text-lg font-semibold text-dark leading-tight">{testimonial.brand}</h3>
              <span class="text-xs text-taupe">{testimonial.role}</span>
            </div>
          </div>

          <!-- Quote -->
          <blockquote class="text-base text-espresso/80 leading-relaxed mb-6 font-light italic">
            "{testimonial.quote}"
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-2 pt-4 border-t border-cream/60">
            <div class="w-1.5 h-1.5 rounded-full bg-mocha/50"></div>
            <span class="text-sm text-taupe font-medium">{testimonial.author}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .testimonial-carousel {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .testimonial-carousel::-webkit-scrollbar {
    display: none;
  }
  .testimonial-carousel > * {
    scroll-snap-align: center;
  }
</style>
