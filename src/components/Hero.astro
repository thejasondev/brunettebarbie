---
// Hero section — elegant gradient background, name, tagline, and CTA
// The real photo is reserved for the About section for better visual hierarchy
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <!-- Animated Gradient Background -->
  <div class="absolute inset-0 z-0 hero-gradient"></div>

  <!-- Decorative Elements -->
  <div class="absolute inset-0 z-1 pointer-events-none overflow-hidden">
    <!-- Floating orbs -->
    <div
      class="absolute top-[15%] left-[10%] w-72 h-72 bg-cream/8 rounded-full blur-3xl hero-float"
    >
    </div>
    <div
      class="absolute bottom-[20%] right-[8%] w-96 h-96 bg-sand/10 rounded-full blur-3xl hero-float-delayed"
    >
    </div>
    <div
      class="absolute top-[50%] left-[60%] w-48 h-48 bg-taupe/6 rounded-full blur-2xl hero-float-slow"
    >
    </div>

    <!-- Subtle grid pattern overlay -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.4) 1px, transparent 0); background-size: 40px 40px;"
    >
    </div>

    <!-- Decorative lines -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-32 bg-gradient-to-b from-transparent via-cream/20 to-transparent"
    >
    </div>
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-px h-32 bg-gradient-to-t from-transparent via-cream/20 to-transparent"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-20 text-center px-6 max-w-4xl mx-auto">
    <!-- Decorative line -->
    <div
      class="flex items-center justify-center gap-4 mb-8 fade-in-up"
      style="animation-delay: 0.2s;"
    >
      <span
        class="block w-16 h-px bg-gradient-to-r from-transparent to-cream/50"
      ></span>
      <span
        class="text-cream/70 text-xs tracking-[0.35em] uppercase font-body font-light"
        >Content Creator & Brand Ambassador</span
      >
      <span
        class="block w-16 h-px bg-gradient-to-l from-transparent to-cream/50"
      ></span>
    </div>

    <!-- Name -->
    <h1
      class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] font-bold text-cream mb-6 fade-in-up leading-[1.1]"
      style="animation-delay: 0.4s;"
    >
      Maria
      <span class="block text-white mt-1">Swindell</span>
    </h1>

    <!-- Social Handles -->
    <div
      class="flex flex-wrap items-center justify-center gap-4 md:gap-6 mb-10 fade-in-up"
      style="animation-delay: 0.6s;"
    >
      <!-- Instagram -->
      <a
        href="https://www.instagram.com/mariaswindell_official"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-cream/80 hover:text-white font-accent text-lg md:text-xl italic tracking-wide transition-colors duration-300"
      >
        <svg
          class="w-5 h-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          ></path>
        </svg>
        @mariaswindell_official
      </a>

      <!-- Divider -->
      <span class="hidden sm:block w-px h-5 bg-cream/30"></span>

      <!-- TikTok -->
      <a
        href="https://www.tiktok.com/@maria.swindell"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-cream/80 hover:text-white font-accent text-lg md:text-xl italic tracking-wide transition-colors duration-300"
      >
        <svg
          class="w-5 h-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.07a8.16 8.16 0 004.76 1.52v-3.4a4.85 4.85 0 01-1-.5z"></path>
        </svg>
        @maria.swindell
      </a>
    </div>

    <!-- CTA -->
    <div class="fade-in-up" style="animation-delay: 0.8s;">
      <a
        href="#contact"
        id="hero-cta"
        class="group inline-flex items-center gap-2.5 px-9 py-4 bg-cream text-espresso font-semibold rounded-full hover:bg-white transition-all duration-300 hover:shadow-[0_8px_32px_rgba(241,222,201,0.3)] hover:-translate-y-1 text-base tracking-wide"
      >
        Let's Collaborate
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Sophisticated gradient background using brand palette */
  .hero-gradient {
    background:
      radial-gradient(
        ellipse 80% 50% at 50% 0%,
        rgba(141, 123, 104, 0.3) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 40% at 80% 80%,
        rgba(164, 144, 124, 0.15) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse 50% 60% at 10% 60%,
        rgba(200, 182, 166, 0.1) 0%,
        transparent 50%
      ),
      linear-gradient(
        180deg,
        #2a221a 0%,
        #3d3226 30%,
        #4a3d30 60%,
        #5a4d3f 100%
      );
  }

  /* Floating animation for decorative orbs */
  .hero-float {
    animation: heroFloat 8s ease-in-out infinite;
  }
  .hero-float-delayed {
    animation: heroFloat 10s ease-in-out infinite 2s;
  }
  .hero-float-slow {
    animation: heroFloat 12s ease-in-out infinite 4s;
  }

  @keyframes heroFloat {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(15px, -20px) scale(1.05);
    }
    66% {
      transform: translate(-10px, 10px) scale(0.95);
    }
  }
</style>
