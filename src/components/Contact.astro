---
// Contact section — direct, transparent, no form
// Premium experience focused on immediate action
---

<section id="contact" class="py-24 md:py-32 relative overflow-hidden bg-dark">
  <!-- Decorative background -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[20%] left-[5%] w-80 h-80 bg-mocha/8 rounded-full blur-3xl"></div>
    <div class="absolute bottom-[10%] right-[10%] w-96 h-96 bg-taupe/6 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0); background-size: 48px 48px;"></div>
  </div>

  <div class="max-w-5xl mx-auto px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="text-sand/60 text-xs tracking-[0.35em] uppercase font-medium block mb-4">Get in Touch</span>
      <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-cream font-bold mb-6 leading-tight">
        Let's Create Something<br class="hidden sm:block" />
        <span class="text-mocha italic">Amazing Together</span>
      </h2>
      <div class="w-16 h-px bg-gradient-to-r from-transparent via-mocha to-transparent mx-auto mb-8"></div>
      <p class="max-w-xl mx-auto text-sand/70 text-lg leading-relaxed">
        I'm always open to exciting collaborations. Reach out directly — I'd love to hear about your brand and vision.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">

      <!-- Instagram Card -->
      <a
        href="https://www.instagram.com/mariaswindell_official"
        target="_blank"
        rel="noopener noreferrer"
        id="contact-instagram"
        class="group relative bg-white/[0.04] backdrop-blur-sm border border-white/[0.08] rounded-2xl p-8 md:p-10 hover:bg-white/[0.08] hover:border-mocha/30 transition-all duration-500 block overflow-hidden"
      >
        <!-- Hover glow -->
        <div class="absolute inset-0 bg-gradient-to-br from-mocha/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"></div>

        <div class="relative z-10">
          <!-- Icon -->
          <div class="w-14 h-14 rounded-2xl bg-mocha/15 flex items-center justify-center mb-6 group-hover:bg-mocha/25 transition-colors duration-300">
            <svg class="w-6 h-6 text-cream" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>

          <!-- Label -->
          <span class="text-sand/50 text-xs tracking-[0.2em] uppercase font-medium block mb-2">Instagram — DMs Open</span>

          <!-- Handle -->
          <h3 class="font-heading text-xl md:text-2xl text-cream font-semibold mb-3 group-hover:text-white transition-colors duration-300">
            @mariaswindell_official
          </h3>

          <!-- Subtext -->
          <p class="text-sand/50 text-sm leading-relaxed mb-6">
            Send a DM for quick conversations, content previews, and collaboration ideas.
          </p>

          <!-- Action -->
          <div class="flex items-center gap-2 text-mocha group-hover:text-cream transition-colors duration-300">
            <span class="text-sm font-medium">Open Instagram</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </div>
        </div>
      </a>

      <!-- TikTok Card -->
      <a
        href="https://www.tiktok.com/@maria.swindell"
        target="_blank"
        rel="noopener noreferrer"
        id="contact-tiktok"
        class="group relative bg-white/[0.04] backdrop-blur-sm border border-white/[0.08] rounded-2xl p-8 md:p-10 hover:bg-white/[0.08] hover:border-mocha/30 transition-all duration-500 block overflow-hidden"
      >
        <!-- Hover glow -->
        <div class="absolute inset-0 bg-gradient-to-br from-mocha/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"></div>

        <div class="relative z-10">
          <!-- Icon -->
          <div class="w-14 h-14 rounded-2xl bg-mocha/15 flex items-center justify-center mb-6 group-hover:bg-mocha/25 transition-colors duration-300">
            <svg class="w-6 h-6 text-cream" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.07a8.16 8.16 0 004.76 1.52v-3.4a4.85 4.85 0 01-1-.5z"></path>
            </svg>
          </div>

          <!-- Label -->
          <span class="text-sand/50 text-xs tracking-[0.2em] uppercase font-medium block mb-2">TikTok — Follow Me</span>

          <!-- Handle -->
          <h3 class="font-heading text-xl md:text-2xl text-cream font-semibold mb-3 group-hover:text-white transition-colors duration-300">
            @maria.swindell
          </h3>

          <!-- Subtext -->
          <p class="text-sand/50 text-sm leading-relaxed mb-6">
            Trending content, behind-the-scenes moments, and creative collaborations on TikTok.
          </p>

          <!-- Action -->
          <div class="flex items-center gap-2 text-mocha group-hover:text-cream transition-colors duration-300">
            <span class="text-sm font-medium">Open TikTok</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </div>
        </div>
      </a>
    </div>

    <!-- Collaboration Categories -->
    <div class="text-center reveal">
      <span class="text-sand/40 text-xs tracking-[0.2em] uppercase font-medium block mb-5">Open to Collaborations In</span>
      <div class="flex flex-wrap items-center justify-center gap-2.5 max-w-2xl mx-auto mb-12">
        {["Fashion", "Beauty", "Lifestyle", "Wellness", "Fitness", "Travel", "Food & Beverage"].map((tag) => (
          <span class="px-4 py-2 text-xs font-medium bg-white/[0.05] text-sand/70 rounded-full border border-white/[0.06] hover:border-mocha/20 hover:text-cream/80 transition-all duration-300 cursor-default">
            {tag}
          </span>
        ))}
      </div>

      <!-- Closing quote -->
      <div class="max-w-lg mx-auto">
        <blockquote class="font-accent text-xl md:text-2xl italic text-sand/40 leading-relaxed">
          "Every partnership I take on is built to last — because real influence takes time."
        </blockquote>
      </div>
    </div>
  </div>
</section>
