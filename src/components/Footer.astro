---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: "Instagram",
    url: "https://www.instagram.com/brunettebarbie.ve",
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  },
  {
    name: "Email",
    url: "mailto:barbiebusiness.contact@gmail.com",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>`,
  },
];
---

<footer class="bg-dark relative overflow-hidden">
  <!-- Elegant separator — three thin lines with fade -->
  <div class="relative py-1">
    <div class="flex items-center justify-center gap-3">
      <div class="h-px flex-1 max-w-40 bg-gradient-to-r from-transparent to-mocha/15"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-mocha/20"></div>
      <div class="h-px w-16 bg-mocha/20"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-mocha/20"></div>
      <div class="h-px flex-1 max-w-40 bg-gradient-to-l from-transparent to-mocha/15"></div>
    </div>
  </div>

  <!-- Footer Content -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-center">
      <!-- Brand -->
      <div class="text-center md:text-left">
        <h3 class="font-heading text-xl font-semibold text-cream/90 mb-1">María Elisa Lugo</h3>
        <p class="text-sand/40 text-sm">Content Creator & Brand Ambassador</p>
      </div>

      <!-- Social Links -->
      <div class="flex items-center justify-center gap-4">
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target={social.url.startsWith("mailto") ? undefined : "_blank"}
            rel={social.url.startsWith("mailto") ? undefined : "noopener noreferrer"}
            aria-label={social.name}
            class="w-10 h-10 rounded-full bg-white/[0.05] border border-white/[0.06] flex items-center justify-center text-sand/50 hover:bg-mocha/20 hover:text-cream hover:border-mocha/20 transition-all duration-300 hover:-translate-y-0.5"
          >
            <span set:html={social.icon} />
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <div class="text-center md:text-right">
        <p class="text-sand/35 text-sm">
          © {currentYear} María Elisa Lugo
        </p>
        <p class="text-sand/20 text-xs mt-1">
          All rights reserved.
        </p>
      </div>
    </div>

    <!-- Back to top -->
    <div class="mt-10 pt-6 border-t border-white/[0.04] text-center">
      <a
        href="#hero"
        class="inline-flex items-center gap-2 text-sand/25 hover:text-cream/60 transition-colors duration-300 text-xs tracking-wider uppercase group"
        aria-label="Back to top"
      >
        <svg class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
        </svg>
        Back to Top
      </a>
    </div>
  </div>
</footer>
