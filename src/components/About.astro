---
import { Image } from "astro:assets";
import profileImage from "../assets/maria-swindell.webp";
---

<section id="about" class="py-20 md:py-28 bg-ivory relative overflow-hidden">
  <!-- Decorative background element -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-cream/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="text-taupe text-sm tracking-[0.3em] uppercase font-medium block mb-3">Get to Know Me</span>
      <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-dark font-bold mb-2">
        About <span class="text-mocha italic">Me</span>
      </h2>
      <div class="w-16 h-0.5 bg-mocha mx-auto mt-6"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Bio Text -->
      <div class="reveal lg:sticky lg:top-28">
        <p class="text-lg md:text-xl text-espresso/90 leading-relaxed mb-6 font-light">
          I'm <strong class="font-semibold text-dark">Maria Swindell</strong>, a Venezuelan-born content creator and brand ambassador based in the U.S. with a passion for fashion, beauty, and authentic storytelling.
        </p>
        <p class="text-base md:text-lg text-taupe leading-relaxed mb-6">
          For over <strong class="text-espresso font-medium">8 years</strong>, I've partnered with leading global brands to create compelling content that drives engagement and builds lasting connections with audiences. My approach combines genuine product advocacy with high-quality visual storytelling.
        </p>
        <p class="text-base md:text-lg text-taupe leading-relaxed mb-8">
          I bring not just reach — but real influence. Every collaboration I take on is a long-term relationship built on trust, creativity, and measurable results.
        </p>
        
        <!-- CTA within about -->
        <div class="flex flex-wrap gap-4">
          <a href="#collaborations" class="inline-flex items-center gap-2 px-6 py-3 bg-mocha text-white font-medium rounded-full hover:bg-espresso transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
            View My Work
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
          </a>
          <a href="https://www.instagram.com/mariaswindell_official" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-mocha text-mocha font-medium rounded-full hover:bg-mocha hover:text-white transition-all duration-300 hover:-translate-y-0.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            Follow Me
          </a>
          <a href="https://www.tiktok.com/@maria.swindell" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-mocha text-mocha font-medium rounded-full hover:bg-mocha hover:text-white transition-all duration-300 hover:-translate-y-0.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.07a8.16 8.16 0 004.76 1.52v-3.4a4.85 4.85 0 01-1-.5z"></path>
            </svg>
            TikTok
          </a>
        </div>
      </div>

      <!-- About Image — full portrait, no crop -->
      <div class="reveal relative">
        <div class="relative rounded-2xl overflow-hidden shadow-card group">
          <Image
            src={profileImage}
            alt="Maria Swindell — Content Creator & Brand Ambassador"
            class="w-full h-auto object-contain rounded-2xl transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <!-- Subtle gradient overlay at bottom only -->
          <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-dark/20 to-transparent"></div>
        </div>
        <!-- Decorative frame -->
        <div class="absolute -bottom-3 -right-3 w-full h-full border-2 border-sand/50 rounded-2xl -z-10"></div>
        <div class="absolute -top-3 -left-3 w-24 h-24 border-t-2 border-l-2 border-mocha/30 rounded-tl-2xl -z-10"></div>
      </div>
    </div>
  </div>
</section>
