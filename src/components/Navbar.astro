---
const navLinks = [
  { label: "About", href: "#about" },
  { label: "Collaborations", href: "#collaborations" },
  { label: "Contact", href: "#contact" },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-100 transition-all duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] -translate-y-full opacity-0 pointer-events-none"
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo / Name -->
      <a href="#hero" id="nav-logo" class="group flex flex-col leading-tight">
        <span class="font-heading text-lg font-semibold text-dark tracking-wide group-hover:text-mocha transition-colors duration-300">
          Maria Swindell
        </span>
        <span class="text-[10px] text-taupe tracking-[0.2em] uppercase">
          @mariaswindell_official
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="relative text-sm font-medium text-espresso/80 hover:text-mocha transition-colors duration-300 tracking-wide uppercase after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[1.5px] after:bg-mocha after:transition-all after:duration-300 hover:after:w-full"
          >
            {link.label}
          </a>
        ))}
        <a
          href="#contact"
          id="nav-cta"
          class="ml-2 px-6 py-2.5 bg-mocha text-white text-sm font-medium rounded-full hover:bg-espresso transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5"
        >
          Let's Collaborate
        </a>
      </div>

      <!-- Mobile CTA (replaces hamburger menu) -->
      <a
        href="#contact"
        class="md:hidden inline-flex items-center gap-1.5 px-5 py-2 bg-mocha text-white text-sm font-medium rounded-full hover:bg-espresso transition-all duration-300 active:scale-95"
      >
        Let's Talk
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
        </svg>
      </a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById("navbar");
  const heroSection = document.getElementById("hero");

  if (navbar && heroSection) {
    // Use IntersectionObserver to detect when hero leaves viewport
    const heroObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            // Hero is out of view → show navbar
            navbar.classList.remove("-translate-y-full", "opacity-0", "pointer-events-none");
            navbar.classList.add("translate-y-0", "opacity-100", "pointer-events-auto", "glass");
            navbar.style.boxShadow = "0 2px 20px rgba(90, 77, 63, 0.06)";
          } else {
            // Hero is in view → hide navbar
            navbar.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
            navbar.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto", "glass");
            navbar.style.boxShadow = "none";
          }
        });
      },
      {
        // Trigger when hero is 15% visible (so navbar appears slightly before hero is fully gone)
        threshold: 0.15,
      }
    );

    heroObserver.observe(heroSection);
  }
</script>

