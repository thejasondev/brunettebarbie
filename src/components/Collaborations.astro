---
import { collaborations } from "../data/collaborations";

const categoryChip: Record<string, string> = {
  "Fashion": "bg-cream text-espresso border-sand/40",
  "Lifestyle": "bg-mocha/10 text-mocha border-mocha/20",
  "Beauty & Skincare": "bg-sand/40 text-espresso border-sand/50",
  "Wellness": "bg-taupe/15 text-taupe border-taupe/25",
  "Fashion Events": "bg-cream text-espresso border-sand/40",
};

const categoryDot: Record<string, string> = {
  "Fashion": "bg-mocha",
  "Lifestyle": "bg-mocha",
  "Beauty & Skincare": "bg-sand",
  "Wellness": "bg-taupe",
  "Fashion Events": "bg-mocha",
};
---

<section id="collaborations" class="py-20 md:py-28 bg-white relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-cream/30 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-10 md:mb-16 reveal">
      <span class="text-taupe text-sm tracking-[0.3em] uppercase font-medium block mb-3">Trusted by Global Brands</span>
      <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-dark font-bold mb-2">
        My <span class="text-mocha italic">Collaborations</span>
      </h2>
      <div class="w-16 h-0.5 bg-mocha mx-auto mt-6 mb-6"></div>
      <p class="max-w-2xl mx-auto text-taupe text-lg">
        Building long-term partnerships with brands that align with my values. Here are some of the incredible companies I've had the privilege to work with.
      </p>
    </div>

    <!-- ============================================ -->
    <!-- MOBILE: Stacked Card Deck (visible < md)     -->
    <!-- ============================================ -->
    <div class="block md:hidden reveal" id="card-deck">
      <div class="relative w-full" id="card-deck-stage" style="height: 470px;">
        {collaborations.map((collab, index) => (
          <a
            href={collab.driveUrl || collab.url}
            target="_blank"
            rel="noopener noreferrer"
            class="collab-card absolute inset-x-0 mx-auto w-[90%] max-w-sm bg-ivory rounded-2xl p-6 shadow-card border border-transparent block"
            style={`z-index: ${collaborations.length - index};`}
            data-index={index}
          >

            {/* Brand Logo + Info Row */}
            <div class="flex items-center gap-4 mb-4">
              <div class="w-14 h-14 rounded-xl overflow-hidden shadow-sm flex-shrink-0">
                <img
                  src={collab.logo}
                  alt={`${collab.name} logo`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width="56"
                  height="56"
                />
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold text-dark leading-tight">
                  {collab.name}
                </h3>
                <span class="text-sm text-taupe">{collab.handle}</span>
              </div>
            </div>

            {/* Category + Duration Row */}
            <div class="flex items-center gap-2 flex-wrap mb-3">
              <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full border ${categoryChip[collab.category] || "bg-cream text-espresso border-sand/40"}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${categoryDot[collab.category] || "bg-mocha"}`}></span>
                {collab.category}
              </span>
              <span class="px-3 py-1 text-xs font-semibold bg-mocha text-white rounded-full">
                {collab.duration}
              </span>
            </div>

            {/* Description */}
            <p class="text-sm text-taupe/90 leading-relaxed mb-4">
              {collab.description}
            </p>

            {/* CTA: Campaign Files (Drive) */}
            <div class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-mocha text-white text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>
              </svg>
              <span>{collab.driveUrl ? "Campaign Files" : "Visit Brand"}</span>
            </div>
          </a>
        ))}
      </div>
      <!-- Deck progress indicator -->
      <div class="flex items-center justify-center gap-2 mt-3 text-taupe/70">
        <span data-deck-progress class="text-xs font-medium tracking-wide">1 / {collaborations.length}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9L12 12.75 15.75 9M8.25 15L12 18.75 15.75 15"/>
        </svg>
        <span class="text-xs">Swipe to browse</span>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- DESKTOP: Original Grid (visible >= md)       -->
    <!-- ============================================ -->
    <div class="hidden md:grid grid-cols-2 lg:grid-cols-4 gap-6">
      {collaborations.map((collab, index) => (
        <div
          class="reveal group relative bg-ivory rounded-2xl p-6 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-2 border border-transparent hover:border-sand/50 flex flex-col"
          style={`animation-delay: ${index * 0.08}s;`}
        >
          {/* Duration Badge */}
          <div class="absolute top-4 right-4">
            <span class="px-3 py-1 text-xs font-semibold bg-mocha text-white rounded-full">
              {collab.duration}
            </span>
          </div>

          {/* Brand Logo */}
          <div class="w-16 h-16 rounded-xl overflow-hidden mb-5 shadow-sm group-hover:shadow-md transition-shadow duration-300">
            <img
              src={collab.logo}
              alt={`${collab.name} logo`}
              class="w-full h-full object-cover"
              loading="lazy"
              width="64"
              height="64"
            />
          </div>

          {/* Brand Info */}
          <h3 class="font-heading text-xl font-semibold text-dark mb-1 group-hover:text-mocha transition-colors duration-300">
            {collab.name}
          </h3>
          <span class="text-sm text-taupe block mb-3">{collab.handle}</span>

          {/* Category Tag */}
          <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full border mb-4 self-start ${categoryChip[collab.category] || "bg-cream text-espresso border-sand/40"}`}>
            <span class={`w-1.5 h-1.5 rounded-full ${categoryDot[collab.category] || "bg-mocha"}`}></span>
            {collab.category}
          </span>

          {/* Description */}
          <p class="text-sm text-taupe/90 leading-relaxed flex-1">
            {collab.description}
          </p>

          {/* CTAs */}
          <div class="mt-5 pt-4 border-t border-cream/60">
            <a
              href={collab.driveUrl || collab.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-mocha text-white text-sm font-medium transition-colors hover:bg-mocha/90"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>
              </svg>
              {collab.driveUrl ? "Campaign Files" : "Visit Brand"}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Note -->
    <div class="text-center mt-12 md:mt-16 reveal">
      <p class="text-taupe text-base italic font-accent text-lg">
        "Every partnership I take on is built to last — because real influence takes time."
      </p>
    </div>
  </div>
</section>

<style>
  /* ===== Stacked Card Deck Styles ===== */
  .collab-card {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center bottom;
    will-change: transform, opacity;
  }

  /* Active card — front of the deck */
  .collab-card[data-state="active"] {
    transform: translateY(0) scale(1);
    opacity: 1;
    z-index: 10 !important;
    box-shadow: 0 8px 40px rgba(90, 77, 63, 0.15);
  }

  /* Next card — peeking behind */
  .collab-card[data-state="next"] {
    transform: translateY(12px) scale(0.96);
    opacity: 0.7;
    z-index: 9 !important;
    pointer-events: none;
  }

  /* Two behind — further back */
  .collab-card[data-state="behind"] {
    transform: translateY(24px) scale(0.92);
    opacity: 0.4;
    z-index: 8 !important;
    pointer-events: none;
  }

  /* All other cards — hidden in deck */
  .collab-card[data-state="hidden"] {
    transform: translateY(36px) scale(0.88);
    opacity: 0;
    z-index: 1 !important;
    pointer-events: none;
  }

  /* Card exiting — flies up and fades out */
  .collab-card[data-state="exiting"] {
    transform: translateY(-30px) scale(0.95);
    opacity: 0;
    z-index: 11 !important;
    pointer-events: none;
  }

</style>

<script>
  function initCardDeck() {
    const deck = document.getElementById("card-deck");
    if (!deck) return;

    const cards = deck.querySelectorAll<HTMLElement>(".collab-card");
    const total = cards.length;

    if (total === 0) return;

    let current = 0;
    let hasInteracted = false;
    let autoTimer: ReturnType<typeof setInterval>;
    let isPaused = false;

    function setCardStates(activeIndex: number, animate = true) {
      cards.forEach((card, i) => {
        const diff = (i - activeIndex + total) % total;
        if (diff === 0) {
          card.dataset.state = "active";
        } else if (diff === 1) {
          card.dataset.state = "next";
        } else if (diff === 2) {
          card.dataset.state = "behind";
        } else {
          card.dataset.state = "hidden";
        }
      });
      updateProgress();
    }

    function updateProgress() {
      const counter = deck.querySelector<HTMLElement>("[data-deck-progress]");
      if (counter) {
        counter.textContent = `${current + 1} / ${total}`;
      }
    }

    const stage = document.getElementById("card-deck-stage");

    function fitStageHeight() {
      if (!stage) return;
      let max = 0;
      cards.forEach((card) => {
        const h = card.offsetHeight;
        if (h > max) max = h;
      });
      stage.style.height = `${max + 32}px`;
    }

    function goToCard(index: number) {
      const currentCard = cards[current] as HTMLElement;
      currentCard.dataset.state = "exiting";
      setTimeout(() => {
        current = index;
        setCardStates(current);
      }, 150);
    }

    function nextCard() {
      const next = (current + 1) % total;
      goToCard(next);
    }

    function stopAutoPlay() {
      if (autoTimer) clearInterval(autoTimer);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoTimer = setInterval(() => {
        if (!isPaused) nextCard();
      }, 6000);
    }

    function startAutoPlayIfUninteracted() {
      if (!hasInteracted) startAutoPlay();
    }

    // Initialize states
    setCardStates(0, false);

    // Start auto-play (6s, stops after first user interaction)
    startAutoPlay();
    fitStageHeight();

    // Touch/swipe support
    let touchStartX = 0;
    let touchStartY = 0;

    deck.addEventListener("touchstart", (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      isPaused = true;
    }, { passive: true });

    deck.addEventListener("touchend", (e: TouchEvent) => {
      const deltaX = e.changedTouches[0].clientX - touchStartX;
      const deltaY = e.changedTouches[0].clientY - touchStartY;

      // Only respond to horizontal swipes (not vertical scroll)
      if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
        hasInteracted = true;
        stopAutoPlay();
        if (deltaX < 0) {
          // Swipe left → next
          nextCard();
        } else {
          // Swipe right → previous
          const prev = (current - 1 + total) % total;
          goToCard(prev);
        }
      }
      isPaused = false;
    }, { passive: true });

    // Pause on touch hold
    deck.addEventListener("touchstart", () => { isPaused = true; }, { passive: true });

    // Stop autoplay permanently after any card tap/click
    deck.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a") || target.closest("button")) {
        hasInteracted = true;
        stopAutoPlay();
      }
    });

    // Visibility API — pause/resume only if user hasn't interacted
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoPlay();
      } else {
        startAutoPlayIfUninteracted();
      }
    });

    window.addEventListener("resize", fitStageHeight);
  }

  // Run on DOM ready
  document.addEventListener("DOMContentLoaded", initCardDeck);
  // Also handle Astro view transitions
  document.addEventListener("astro:page-load", initCardDeck);
</script>
